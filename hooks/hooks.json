{
  "description": "Codex Conductor project-state, blocking-decision, and single-worker orchestration hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/conductor.py session-start",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\conductor.py\" session-start",
            "statusMessage": "Loading Codex Conductor project state",
            "additionalContextLimit": 9000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/conductor.py prompt-submit",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\conductor.py\" prompt-submit",
            "statusMessage": "Syncing Codex Conductor task context",
            "additionalContextLimit": 9000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|followup_task|Agent|request_user_input_async)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/conductor.py pre-tool",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\conductor.py\" pre-tool",
            "statusMessage": "Checking Codex Conductor gate and worker slot"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/conductor.py subagent-start",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\conductor.py\" subagent-start",
            "statusMessage": "Applying Codex Conductor worker policy",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/conductor.py subagent-stop",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\conductor.py\" subagent-stop",
            "statusMessage": "Returning worker result to Codex Conductor",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/conductor.py stop",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\conductor.py\" stop",
            "statusMessage": "Checking Codex Conductor decision gates"
          }
        ]
      }
    ]
  }
}
